{
  "name": "izing.open.io",
  "version": "2.0.1",
  "description": "izing.open.io - sistema de atendimentos multicanal",
  "main": "index.js",
  "packageManager": "bun@1.3.14",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:ldurans/izing.io.git"
  },
  "scripts": {
    "backend:build": "cd backend && bun run build",
    "frontend:build": "cd frontend && bun run build",
    "build": "bun run backend:build && bun run frontend:build",
    "release": "semantic-release --no-ci",
    "husk": "husky install"
  },
  "author": "Durans (lumardyelson@gmail.com)",
  "license": "AGPL-3.0-or-later",
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.5"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  }
}
