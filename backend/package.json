  "main": "index.js",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "nodemon --inspect  dist/server.js",
    "dev:server": "ts-node-dev --inspect=9229 --respawn --transpile-only --ignore node_modules src/server.ts",
    "pretest": "NODE_ENV=test bunx sequelize db:migrate && NODE_ENV=test bunx sequelize db:seed:all",
    "test": "NODE_ENV=test jest",
    "posttest": "NODE_ENV=test bunx sequelize db:migrate:undo:all",
    "db:migrate": "rm -Rf dist && bun run build && bunx sequelize db:migrate",
    "db:seed": "bunx sequelize db:seed:all"
  },
  "engines": {
    "node": ">=18"
  },
